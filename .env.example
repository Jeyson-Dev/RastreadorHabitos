# Variables del proyecto (Práctica 4). Único paso previo: copiar este archivo a .env
#   cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
# y ejecutar docker compose up --build. Todos los valores son de EJEMPLO: funcionan para levantar
# el proyecto en un equipo de pruebas, pero no son secretos reales. El .env no se versiona.

# --- SQL Server (servicio sqlserver) ---
# Contraseña del usuario sa: 8 caracteres o más, con mayúsculas, minúsculas y números o símbolos.
MSSQL_SA_PASSWORD=Ejemplo-Sql2026
# Cadena de conexión de la aplicación: el servidor es el servicio "sqlserver", no localhost.
ConnectionStrings__RastreadorHabitos=Server=sqlserver,1433;Database=RastreadorHabitos;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True

# --- Credencial de sesión ---
# Clave para firmar las credenciales de sesión (JWT): 32 caracteres o más.
Jwt__Clave=clave-de-ejemplo-para-firmar-sesiones-cambiela-2026

# --- Enlaces de los correos ---
# Dirección con la que se arman los enlaces de activación: la del puerto publicado de la app.
App__UrlBase=http://localhost:5003

# --- Manejador de documentos ---
# Carpeta de los archivos dentro del contenedor; ahí se monta el volumen "documentos".
Documentos__Ruta=/app/documentos

# --- Correo saliente (enviador de la cola) ---
# Por defecto, Mailpit: un servidor de captura de la composición. Los correos se leen en
# http://localhost:8025. Para enviar correos reales, poner aquí un servidor SMTP real
# (por ejemplo smtp.gmail.com, 587, UsarSsl=true, y una contraseña de aplicación).
Smtp__Host=mailpit
Smtp__Puerto=1025
Smtp__UsarSsl=false
Smtp__Remitente=no-responder@rastreadorhabitos.local
Smtp__Usuario=usuario-de-ejemplo
Smtp__Contrasena=contrasena-de-ejemplo

# --- API externa de clima (WeatherAPI.com) ---
# Clave gratuita de https://www.weatherapi.com/signup.aspx. Con este valor de ejemplo la
# operación GET /api/habitos/hoy responde un rechazo controlado (503) y el resto funciona.
WeatherApi__Clave=clave-de-ejemplo-de-weatherapi

# --- Zona horaria del servidor ---
# «Hoy» para los registros diarios y las metas es la fecha local del servidor.
TZ=America/Santo_Domingo
