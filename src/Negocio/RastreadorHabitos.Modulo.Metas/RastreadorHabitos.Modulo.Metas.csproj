<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!-- Llega por Microsoft.Data.SqlClient; se fija una versión sin las vulnerabilidades GHSA-846f-f764-76mx y GHSA-2fmv-rv2c-59x7. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Metas depende de Hábitos (contarCumplidos), nunca al revés. -->
    <ProjectReference Include="..\RastreadorHabitos.Modulo.Habitos\RastreadorHabitos.Modulo.Habitos.csproj" />
    <!-- Solo para notificar el cambio de estado de una meta a su dueño [RF-NOT-03]. -->
    <ProjectReference Include="..\..\Core\RastreadorHabitos.Core.Notificaciones\RastreadorHabitos.Core.Notificaciones.csproj" />
  </ItemGroup>

</Project>
